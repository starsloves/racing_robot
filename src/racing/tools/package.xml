<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypesets="http://download.ros.org/schema/package_format3.xsd"?>
<package format="3">
  <name>racing_tools</name>
  <version>0.0.1</version>
  <description>Racing debugging tools — data recorder, video recorder, realtime web monitor</description>
  <maintainer email="user@example.com">Your Name</maintainer>
  <license>Apache License 2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>python3-opencv</depend>
  <depend>python3-numpy</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>origincar_bringup</exec_depend>
  <exec_depend>lslidar_driver</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
