# 惯导参数测试：位姿/航向/计程/控制统一用轮速 /odom（与 origincar_base 编码器同源）
# /odom_combined 仅作对比日志，不参与导航

stage2_inertial_navigator:
  ros__parameters:
    navigation_pose_source: wheel
    wheel_odom_topic: /odom
    odom_topic: /odom_combined
    wheel_odom_warmup_sec: 0.40
    wheel_odom_warmup_min_msgs: 5

    use_corridor_path: true
    pre_loop_plan_json: '[]'
    post_corridor_path_plan_json: '[{"type":"pause","duration":0.20,"description":"corridor_arrive_settle"}]'

    session_log_subdir: direct_inertial_test
    session_log_filename: latest.log
    session_telemetry_interval_sec: 0.25

    avoid_leg2_distance_m: 0.40

    # 转弯控制：head_tol 1.5° 强迫转到位；turn_min 0.18 让接近目标时不再过度补偿
    # 修复 2026-06-06 实跑：每 90° 转弯少转 3-5°，4 个弯累积 16° 导致 2.80m 顶边偏 0.77m 出界
    heading_tolerance_deg: 1.5        # 原 4.0；缩到 1.5° 强制转到位（轮速 yaw 分度 < 1°）
    turn_angular_speed: 0.80          # 原 0.75；提到 0.80 让 90° 用 1.96s 完成
    turn_min_angular_speed: 0.18      # 原 0.45；小角度时不再 0.45 过度补偿/摆动
    turn_kp: 2.0                      # 原 1.8；提高响应
