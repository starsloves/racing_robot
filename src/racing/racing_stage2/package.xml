<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>racing_stage2</name>
  <version>0.0.1</version>
  <description>Stage 2 inertial navigation and perception nodes for racing competition</description>
  <maintainer email="your_email@example.com">Your Name</maintainer>
  <license>Apache License 2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>ament_index_python</depend>
  <depend>launch</depend>
  <depend>launch_ros</depend>
  <depend>rclpy</depend>
  <depend>cv_bridge</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>racing_common</depend>
  <depend>racing_tools</depend>
  <depend>sensor_msgs</depend>
  <depend>racing_stage1</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>python3-opencv</depend>
  <depend>python3-numpy</depend>

  <!-- direct_inertial_test.launch.py support stack; deps for packages-up-to build -->
  <depend>ackermann_msgs</depend>
  <depend>lslidar_driver</depend>
  <depend>lslidar_msgs</depend>
  <depend>origincar_base</depend>
  <depend>origincar_bringup</depend>
  <depend>origincar_description</depend>
  <depend>origincar_msg</depend>
  <depend>serial</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
