# ============================================================
# voice_driver — Origincar 语音播报
# 路径: src/racing/voice_driver/.env
# ============================================================

# ---------- 出声设备 ----------
# mae01  = 仅串口语音模块
# alsa   = RDK 板载/USB 音箱（百炼 TTS 任意长文本，需外接喇叭）
# both   = 先串口模块，失败再使用云端 TTS（推荐）
AUDIO_OUTPUT=both

# ---------- 百炼 API（视觉 + TTS）----------
VISION_PROVIDER=ark
DASHSCOPE_API_KEY='<your-api-key>'
DASHSCOPE_MODEL_ID=qwen3.7-plus
ARK_API_KEY=
ARK_MODEL_ID=doubao-1.5-vision-lite-250315
VISION_PROMPT=请用一小段话简单描述这张图片中的内容，包括物体、场景、颜色等信息。

TTS_PROVIDER=auto
DASHSCOPE_TTS_MODEL=qwen-tts-realtime-2025-07-15
DASHSCOPE_TTS_VOICE=Cherry
DASHSCOPE_TTS_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime

# ---------- 串口语音模块 ----------
# UART: 勿用 ttyACM0（电机板）
VOICE_SERIAL_PORT=/dev/ttyS1
VOICE_SERIAL_BAUD=9600

# ---------- 板载音频（仅 AUDIO_OUTPUT=alsa/both 时用）----------
AUDIO_DEVICE=plughw:0,0
AUDIO_PLAYER=aplay

# ---------- ROS 话题 ----------
# full     = 节点自己订阅 sign4return+/image 做视觉并播报（与 racing_vision_ai 重复）
# tts_only = 只订阅 ai_description，播报 racing_vision_ai 的图片识别结果（推荐）
BROADCAST_MODE=tts_only
TARGET_SIGN=9
SIGN_TOPIC=sign4return
IMAGE_TOPIC=/image
AI_DESCRIPTION_TOPIC=ai_description
